{# ==========================================================================
   login.html.twig — Tela de login do Aether
   Não estende base.html.twig (tela isolada, sem sidebar/bottom nav).
   Estilo: superfícies sólidas, tokens claro/escuro (public/css/base.css) e
   alternância de tema salva em localStorage (public/js/components/theme-toggle.js).
   CSS puro: não depende do build do Tailwind (public/build/app.css).
========================================================================== #}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Acesso · Aether</title>
    <meta name="theme-color" content="#EDF1F2" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0A0E11" media="(prefers-color-scheme: dark)">

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='15' cy='17' r='9' fill='none' stroke='%23FF8A1F' stroke-width='2.6'/%3E%3Ccircle cx='15' cy='17' r='3' fill='none' stroke='%23FF8A1F' stroke-width='2.4'/%3E%3Ccircle cx='25.6' cy='7.6' r='2.2' fill='%23FF8A1F'/%3E%3C/svg%3E">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('css/base.css') }}">
    <link rel="stylesheet" href="{{ asset('css/pages/login.css') }}">

    {# Sem defer de propósito: aplica o tema salvo antes da primeira pintura (evita piscar). #}
    <script src="{{ asset('js/components/theme-toggle.js') }}"></script>
</head>
<body>

<header class="topbar">
    <div class="wrap topbar-inner">
        <a class="brand" href="{{ path('app_login') }}">
            {% include 'partials/_brand.html.twig' %}
        </a>
        <div class="tools">
            <button type="button" class="theme-toggle" id="theme" aria-label="Alternar tema">
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
        </div>
    </div>
</header>

<main class="login-shell">
    <div class="login-card">

        <div class="login-head">
            {% include 'partials/_brand_icon.html.twig' %}
            <h1>Entrar</h1>
            <p>Acesso ao núcleo do ecossistema</p>
        </div>

        {% if error %}
            <div class="login-error" role="alert">
                {# O filtro trans traduz o erro para o idioma do usuário (ex: "Senha inválida") #}
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="login-field">
                <label for="inputIdentificador">Identificador</label>
                <input type="text" id="inputIdentificador" name="username"
                       value="{{ last_username|default('') }}"
                       autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
            </div>

            <div class="login-field">
                <label for="inputChave">Chave de acesso</label>
                <input type="password" id="inputChave" name="password"
                       autocomplete="current-password" required>
            </div>

            <button type="submit" class="btn btn-primary btn-lg login-submit">Acessar ecossistema</button>
        </form>

        <p class="eyebrow login-foot">Core — Acesso restrito</p>
    </div>
</main>

</body>
</html>
