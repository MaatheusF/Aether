{% extends 'layout/app_base.html.twig' %}

{# ==========================================================================
   modulos/poseidon/dispositivo.html.twig — Detalhe de um dispositivo Poseidon
   Substitui o seletor lateral por um link "← Poseidon" (ver back-link em
   components.css) e o submenu Visão Geral/Iluminação/Filtragem/Clima/Logs
   (que eram só href="#", prometendo páginas que não existem) por 3 abas
   que rolam pra seções REAIS desta mesma página — Filtragem e Clima não
   têm seção própria ainda, então não entraram como aba.

   Variável esperada (ver ModuloController::poseidonDispositivo): dispositivo
   (PoseidonDevice) — a checagem de "nenhum dispositivo cadastrado" agora é
   responsabilidade da lista (lista.html.twig), não mais desta página.
========================================================================== #}

{% block title %}{{ dispositivo.nome }}{% endblock %}
{% block active_view %}poseidon{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pages/poseidon.css') }}">
{% endblock %}

{% block bar %}
    <div class="bar">
        <button type="button" class="theme-toggle rail-toggle-btn" id="rail-toggle" aria-label="Abrir menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <div class="bar-title">
            <a href="{{ path('app_modulo_poseidon') }}" class="back-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                Poseidon
            </a>
        </div>
        <button type="button" class="theme-toggle" id="theme" aria-label="Alternar tema">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
    </div>
{% endblock %}

{% block content %}

    {# --------------------- Cabeçalho --------------------- #}
    <div class="hero">
        <div>
            <p class="eyebrow">Poseidon · {{ dispositivo.tipo == 'paludario' ? 'Paludário' : 'Aquário' }}</p>
            <h1>{{ dispositivo.nome }}</h1>
        </div>
        <span class="pill {{ dispositivo.status == 'online' ? 'online' : (dispositivo.status == 'alert' ? 'alert' : (dispositivo.status == 'pending' ? 'pending' : '')) }}">
            <span class="pill-dot"></span>{{ dispositivo.status == 'online' ? 'Online' : (dispositivo.status == 'alert' ? 'Alerta' : (dispositivo.status == 'pending' ? 'Pendente' : 'Offline')) }}
        </span>
    </div>

    {# --------------------- Aviso de conectividade --------------------- #}
    {% if dispositivo.status != 'online' %}
        <div class="status-banner{{ dispositivo.status == 'alert' ? ' alert' : '' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>
            {% if dispositivo.status == 'alert' %}
                Este dispositivo reportou uma falha e pode não estar respondendo a comandos.
            {% elseif dispositivo.status == 'pending' %}
                Este dispositivo ainda não completou o primeiro handshake com o Core — os controles abaixo ficam disponíveis assim que ele conectar.
            {% else %}
                Sem conexão com o Core — os controles abaixo estão indisponíveis e a telemetria pode estar desatualizada.
            {% endif %}
        </div>
    {% endif %}

    {# --------------------- Abas (rolam pra seções desta mesma página) --------------------- #}
    <nav class="view-tabs">
        <a href="#acoes" class="on">Ações Rápidas</a>
        <a href="#telemetria">Telemetria</a>
        <a href="#logs">Logs</a>
    </nav>

    {# =========================================================================
       ZONA 1 — Ações Rápidas
       Toggles reais (ver public/js/services/atuador_control.js) e sliders de
       iluminação (ainda sem fio — valores fixos, mesma demo de antes). Fica
       visualmente desabilitada só em offline/pending (sem conexão real pra
       confirmar qualquer ação) — "alert" continua habilitada de propósito:
       o dispositivo está conectado e pode aceitar comandos normalmente,
       só reportou uma falha. #}
    <section class="zone{{ dispositivo.status in ['offline', 'pending'] ? ' is-disabled' : '' }}" id="acoes">
        <div class="zone-head"><p class="eyebrow">Ações Rápidas</p></div>
        <div class="zone-card">
            <div class="actions-grid">

                {# Toggle: Cascata — estado normal (ligado) #}
                <div data-atuador-grupo class="toggle-card">
                    <div>
                        <p class="toggle-card-name">Cascata</p>
                        <p data-texto-on="ativa" data-texto-off="inativa"
                           data-classe-on="toggle-label on" data-classe-off="toggle-label off"
                           class="toggle-label on">ativa</p>
                    </div>
                    <button type="button" role="switch" aria-checked="true" aria-label="Cascata"
                            data-modulo="poseidon" data-atuador="cascata" data-dispositivo="{{ dispositivo.slug }}"
                            class="toggle on"><span class="toggle-thumb"></span></button>
                </div>

                {# Toggle: Névoa — estado desligado #}
                <div data-atuador-grupo class="toggle-card">
                    <div>
                        <p class="toggle-card-name">Névoa</p>
                        <p data-texto-on="ativa" data-texto-off="inativa"
                           data-classe-on="toggle-label on" data-classe-off="toggle-label off"
                           class="toggle-label off">inativa</p>
                    </div>
                    <button type="button" role="switch" aria-checked="false" aria-label="Névoa"
                            data-modulo="poseidon" data-atuador="nevoa" data-dispositivo="{{ dispositivo.slug }}"
                            class="toggle off"><span class="toggle-thumb"></span></button>
                </div>

                {# Toggle: Bombeamento — demonstração permanente do visual "Pendente" #}
                <div class="toggle-card pending">
                    <div>
                        <p class="toggle-card-name">Bombeamento</p>
                        <p class="toggle-label pending">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
                            pendente
                        </p>
                    </div>
                    <button type="button" role="switch" aria-checked="true" aria-label="Bombeamento" disabled
                            data-modulo="poseidon" data-atuador="bombeamento" data-dispositivo="{{ dispositivo.slug }}"
                            class="toggle pending"><span class="toggle-thumb"></span></button>
                </div>
            </div>

            {# Sliders de iluminação — ainda sem fio, mesmos valores de demonstração #}
            <div class="sliders-grid">
                <div class="slider-row">
                    <div class="slider-head">
                        <label>LED 6500K</label>
                        <span class="slider-value" style="color: var(--text-ice);">72%</span>
                    </div>
                    <input type="range" class="bio-slider" min="0" max="100" value="72">
                </div>
                <div class="slider-row">
                    <div class="slider-head">
                        <label>Grow (Fotossíntese)</label>
                        <span class="slider-value" style="color: var(--text-ok);">54%</span>
                    </div>
                    <input type="range" class="bio-slider" min="0" max="100" value="54">
                </div>
                <div class="slider-row">
                    <div class="slider-head">
                        <label>RGB Ambiente</label>
                        <span class="slider-value" style="color: var(--text-warn);">30%</span>
                    </div>
                    <input type="range" class="bio-slider" min="0" max="100" value="30">
                </div>
            </div>
        </div>
    </section>

    {# =========================================================================
       ZONA 2 — Telemetria
       Placeholders tracejados pros gráficos (Chart.js) de temperatura e
       umidade. IDs dos canvas incluem o slug do dispositivo.
    ========================================================================= #}
    <section class="zone" id="telemetria">
        <div class="zone-head"><p class="eyebrow">Telemetria</p></div>
        <div class="zone-card">
            <div class="chart-grid">
                {# Placeholder: gráfico de temperatura — plugar Chart.js aqui #}
                <div class="chart-placeholder">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13.5 8 8l4 4 5.5-6.5M21 8v5.5m0 0h-5.5"/></svg>
                    <p>Gráfico de Temperatura (água / ar)<br>
                        <span class="chart-note">canvas Chart.js — id="chart-temperatura-{{ dispositivo.slug }}"</span></p>
                </div>
                {# Placeholder: gráfico de umidade — plugar Chart.js aqui #}
                <div class="chart-placeholder">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c-4.5-4.5-7.5-8-7.5-11.5A7.5 7.5 0 0 1 12 2a7.5 7.5 0 0 1 7.5 7.5c0 3.5-3 7-7.5 11.5Z"/></svg>
                    <p>Umidade do Solo (círculos concêntricos)<br>
                        <span class="chart-note">canvas Chart.js — id="chart-umidade-{{ dispositivo.slug }}"</span></p>
                </div>
            </div>
        </div>
    </section>

    {# =========================================================================
       ZONA 3 — Console de Logs
       Terminal simulando o fluxo de dados brutos do Core, filtrado pro
       dispositivo selecionado.
    ========================================================================= #}
    <section class="zone" id="logs">
        <div class="zone-head">
            <p class="eyebrow">Console de Logs</p>
            <span class="stream-live"><span class="pill-dot vital-dot"></span>stream ativo</span>
        </div>
        <div class="zone-card">
            {# Cada linha representa um pacote recebido do Core PARA ESTE dispositivo —
               substituir por loop Twig/JS filtrando pelo device_name = dispositivo.slug #}
            <div class="log-console">
                <p>[12:04:01] <span class="log-slug">{{ dispositivo.slug }}</span> :: heartbeat ok</p>
                <p>[12:04:03] <span class="log-slug">{{ dispositivo.slug }}</span> :: sensor.temp_agua :: {{ dispositivo.telemetria.temp_agua|default('--') }}</p>
                <p>[12:04:03] <span class="log-slug">{{ dispositivo.slug }}</span> :: sensor.umidade :: {{ dispositivo.telemetria.umidade|default('--') }}</p>
                <p>[12:04:06] <span class="log-pending">{{ dispositivo.slug }}</span> :: actuator.bomba :: aguardando ack...</p>
                <p>[12:04:07] <span class="log-ok">{{ dispositivo.slug }}</span> :: heartbeat ok</p>
            </div>
        </div>
    </section>

{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/services/atuador_control.js') }}"></script>
{% endblock %}
