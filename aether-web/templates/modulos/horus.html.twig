{% extends 'layout/app_base.html.twig' %}

{# ==========================================================================
   modulos/horus.html.twig — Módulo Horus (Segurança)
   Ao contrário do Poseidon, SEM lista/detalhe — o Horus é uma instância
   única por instalação (portão + câmeras fazem parte do mesmo módulo, não
   de dispositivos separados), então o item do rail leva direto aqui.

   O submenu antigo (Visão Geral/Portão/Câmeras/Configurações/Logs, só
   href="#") virou 3 abas que rolam pra seções reais desta mesma página —
   mesmo critério usado no Poseidon. "Configurações" não tinha seção
   própria, então não entrou.

   Variável esperada (ver ModuloController::horus): horus (HorusStatus)
========================================================================== #}

{% block title %}Horus{% endblock %}
{% block active_view %}horus{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pages/horus.css') }}">
{% endblock %}

{% block bar %}
    <div class="bar">
        <button type="button" class="theme-toggle rail-toggle-btn" id="rail-toggle" aria-label="Abrir menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <div class="bar-title">
            <p class="eyebrow">Módulo · Segurança</p>
            <h1>Horus</h1>
        </div>
        <span class="pill {{ horus.status == 'online' ? 'online' : (horus.status == 'alert' ? 'alert' : '') }}">
            <span class="pill-dot"></span>{{ horus.status == 'online' ? 'Online' : (horus.status == 'alert' ? 'Alerta' : 'Offline') }}
        </span>
        <button type="button" class="theme-toggle" id="theme" aria-label="Alternar tema">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
    </div>
{% endblock %}

{% block content %}

    {# --------------------- Aviso de conectividade --------------------- #}
    {% if horus.status != 'online' %}
        <div class="status-banner{{ horus.status == 'alert' ? ' alert' : '' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>
            {% if horus.status == 'alert' %}
                Este módulo reportou uma falha e pode não estar respondendo a comandos.
            {% else %}
                Sem conexão com o Core — os controles abaixo estão indisponíveis e as câmeras podem estar desatualizadas.
            {% endif %}
        </div>
    {% endif %}

    {# --------------------- Abas --------------------- #}
    <nav class="view-tabs">
        <a href="#acesso" class="on">Controle de Acesso</a>
        <a href="#cameras">Câmeras</a>
        <a href="#logs">Logs</a>
    </nav>

    {# =========================================================================
       ZONA 1 — Controle de Acesso
       O portão é a ação mais crítica do módulo, por isso vem em destaque
       próprio (não misturado com toggles genéricos como no Poseidon).
       Desabilitada só quando offline (sem conexão real pra confirmar
       qualquer ação) — "alert" fica habilitada de propósito, mesmo
       critério usado no Poseidon.
    ========================================================================= #}
    <section class="zone{{ horus.status == 'offline' ? ' is-disabled' : '' }}" id="acesso">
        <div class="zone-head"><p class="eyebrow">Controle de Acesso</p></div>
        <div class="zone-card">

            <div data-atuador-grupo
                 data-classe-on="access-card"
                 data-classe-off="access-card unlocked"
                 class="access-card{{ horus.portaoEstado == 'travado' ? '' : ' unlocked' }}">
                <div class="access-left">
                    <span data-classe-on="access-icon" data-classe-off="access-icon"
                          class="access-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9.75V6a3.75 3.75 0 1 1 7.5 0M6.75 21h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75A2.25 2.25 0 0 0 6.75 21Z"/></svg>
                    </span>
                    <div>
                        <p class="access-name">Portão Principal</p>
                        <p data-texto-on="Travado" data-texto-off="Destravado"
                           data-classe-on="access-state on" data-classe-off="access-state off"
                           class="access-state {{ horus.portaoEstado == 'travado' ? 'on' : 'off' }}">
                            {{ horus.portaoEstado == 'travado' ? 'Travado' : 'Destravado' }}
                        </p>
                    </div>
                </div>

                <div class="access-right">
                    <div class="access-toggle-wrap">
                        <span>Trava</span>
                        <button type="button" role="switch" aria-checked="{{ horus.portaoEstado == 'travado' ? 'true' : 'false' }}"
                                aria-label="Travamento do portão principal"
                                data-modulo="horus" data-atuador="portao"
                                class="toggle {{ horus.portaoEstado == 'travado' ? 'on' : 'off' }}"><span class="toggle-thumb"></span></button>
                    </div>

                    {# Botão de ação momentânea — dispara um pulso no relé do portão,
                       sem estado (o portão não sabe se vai abrir ou fechar, depende
                       de onde ele parou fisicamente). Contrato próprio (data-url +
                       data-cooldown-ms), com confirmação — ver
                       public/js/services/horus_gate_control.js e o modal no fim
                       desta página. Não usa o padrão genérico data-acao do
                       atuador_control.js porque pede essa confirmação extra. #}
                    <button type="button" id="btn-portao-atuador" data-cooldown-ms="4000"
                            data-url="{{ path('app_horus_portao_debug_abrir') }}"
                            class="btn">
                        Atuar
                    </button>
                </div>
            </div>

            <p class="access-note">{{ horus.dispositivosAtivos }} de {{ horus.dispositivosTotal }} dispositivos conectados ao módulo.</p>
        </div>
    </section>

    {# =========================================================================
       ZONA 2 — Câmeras de Segurança
       Placeholders — plugar o player (RTSP/HLS) de cada câmera aqui.
    ========================================================================= #}
    <section class="zone" id="cameras">
        <div class="zone-head">
            <p class="eyebrow">Câmeras de Segurança</p>
            <p class="section-count">{{ horus.camerasAtivas }}/{{ horus.camerasTotal }} ativas</p>
        </div>
        <div class="zone-card">
            <div class="cam-grid">
                {# canal != null → câmera já exposta pelo Core (GET /api/horus/cameras/:canal/snapshot).
                   As demais seguem como placeholder até o Core expor os canais correspondentes. #}
                {% set cameras = [
                    { nome: 'Entrada', canal: 1 },
                    { nome: 'Garagem', canal: null },
                    { nome: 'Quintal', canal: null },
                    { nome: 'Portão', canal: null },
                ] %}
                {% for cam in cameras %}
                    {% if cam.canal %}
                        <div class="cam-tile">
                            <img data-camera-snapshot data-camera-channel="{{ cam.canal }}" alt="Câmera · {{ cam.nome }}">
                            {# Bolinha de atualização do snapshot — verde (.ok) enquanto a
                               última atualização tiver menos de 10s, vermelha (.stale) se
                               passar disso sem uma nova imagem chegar. Controlada por
                               camera_snapshot.js. #}
                            <span data-camera-status-dot class="pill-dot ok vital-dot cam-status-dot"></span>
                            <p class="cam-caption">Câmera · {{ cam.nome }}</p>
                        </div>
                    {% else %}
                        <div class="cam-tile-empty">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 10.5V6a1.5 1.5 0 0 0-1.5-1.5H4.5A1.5 1.5 0 0 0 3 6v9a1.5 1.5 0 0 0 1.5 1.5h9A1.5 1.5 0 0 0 15 15v-4.5Zm0 0 4.72-2.36a.75.75 0 0 1 1.08.67v7.38a.75.75 0 0 1-1.08.67L15 13.5"/></svg>
                            <p>Câmera · {{ cam.nome }}<br>
                                <span class="chart-note">player — id="cam-{{ cam.nome|lower }}"</span></p>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </section>

    {# =========================================================================
       ZONA 3 — Console de Logs
       Mesmo padrão de terminal do Poseidon, com eventos do módulo Horus.
    ========================================================================= #}
    <section class="zone" id="logs">
        <div class="zone-head">
            <p class="eyebrow">Console de Logs</p>
            <span class="stream-live"><span class="pill-dot vital-dot"></span>stream ativo</span>
        </div>
        <div class="zone-card">
            {# Cada linha representa um evento recebido do Core (conexão/desconexão
               de dispositivo, mudança do portão, falha de câmera) — substituir
               por loop Twig/JS com dados reais assim que existirem. #}
            <div class="log-console">
                <p>[13:10:02] <span class="log-ok">horus.core</span> :: heartbeat ok</p>
                <p>[13:09:41] <span class="log-pending">portao.principal</span> :: destravado (via API)</p>
                <p>[13:07:15] <span class="log-slug">cam.garagem</span> :: reconectada</p>
                <p>[13:02:03] <span class="log-danger">sensor.janela_02</span> :: sem resposta há 5min</p>
                <p>[12:58:47] <span class="log-ok">horus.core</span> :: heartbeat ok</p>
            </div>
        </div>
    </section>

    {# Confirmação antes de acionar o portão — evita abrir/fechar sem querer
       num toque acidental. Ver public/js/services/horus_gate_control.js. #}
    <div id="portao-confirm-overlay" class="modal-overlay hidden">
        <div class="modal-card">
            <h2>Confirmar acionamento do portão</h2>
            <p>Isso vai enviar o comando de abertura ou fechamento para o Portão agora. Deseja continuar?</p>
            <div class="modal-actions">
                <button type="button" id="portao-confirm-cancelar" class="btn">Cancelar</button>
                <button type="button" id="portao-confirm-aceitar" class="btn btn-warn">Confirmar</button>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/services/atuador_control.js') }}"></script>
    <script src="{{ asset('js/services/camera_snapshot.js') }}"></script>
    <script src="{{ asset('js/services/horus_gate_control.js') }}"></script>
{% endblock %}
