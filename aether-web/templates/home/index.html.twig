{% extends 'layout/app_base.html.twig' %}

{# ==========================================================================
   home/index.html.twig — Visão Geral do Ecossistema
   Usa exatamente as mesmas variáveis que o DashboardController já envia
   (resumo, alertas, dispositivos_poseidon, horus) — nenhuma mudança no
   controller foi necessária pra essa troca de visual.
========================================================================== #}

{% block title %}Visão Geral{% endblock %}
{% block active_view %}dashboard{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pages/home.css') }}">
{% endblock %}

{% block bar %}
    <div class="bar">
        <button type="button" class="theme-toggle rail-toggle-btn" id="rail-toggle" aria-label="Abrir menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>

        <div class="bar-title">
            <p class="eyebrow">Core · Status geral</p>
            <h1>Visão do Ecossistema</h1>
        </div>

        <p class="sync-note">Última sincronia: <b>há 4s</b></p>

        <button type="button" class="theme-toggle" id="theme" aria-label="Alternar tema">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
    </div>
{% endblock %}

{% block content %}

    {# --------------------- Resumo rápido --------------------- #}
    <div class="summary">
        <div><b class="num">{{ resumo.dispositivos_total }}</b><span>Dispositivos</span></div>
        <div><b class="num ok">{{ resumo.dispositivos_online }}</b><span>Online</span></div>
        <div><b class="num {{ alertas|length > 0 ? 'warn' : 'ok' }}">{{ alertas|length }}</b><span>Alertas ativos</span></div>
    </div>

    {# --------------------- Cards de alerta ---------------------
       O DashboardController já filtra 'estavel' antes de chegar aqui e já
       ordena crítico antes de atenção — então 'alertas' só tem o que
       precisa da sua atenção, nessa ordem. Sem alertas, mostra uma faixa
       calma em vez de simplesmente sumir (sumir sem dizer nada deixa a
       dúvida "isso é porque está tudo bem, ou porque algo quebrou?"). #}
    {% if alertas is empty %}
        <div class="alerts-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
            <span>Tudo estável — nenhum alerta no momento.</span>
        </div>
    {% else %}
        <div class="alerts">
            {% for alerta in alertas %}
                <div class="alert-card {{ alerta.nivel }}">
                    <span class="alert-dot"></span>
                    <div>
                        <p class="alert-label">
                            {{ alerta.nivel == 'critico' ? 'Crítico' : 'Atenção' }} · {{ alerta.dispositivo }}
                        </p>
                        <p class="alert-msg">{{ alerta.mensagem }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# --------------------- Seção: Poseidon --------------------- #}
    <div class="section-head">
        <p class="eyebrow">Poseidon</p>
        <p class="section-count">{{ dispositivos_poseidon|length }} dispositivo{{ dispositivos_poseidon|length != 1 ? 's' : '' }}</p>
    </div>
    <div class="devices">
        {% for d in dispositivos_poseidon %}
            <a href="{{ path('app_modulo_poseidon_dispositivo', { slug: d.slug }) }}" class="device-card">
                <div class="device-top">
                    <div>
                        <p class="device-type">{{ d.tipo == 'paludario' ? 'Paludário' : 'Aquário' }}</p>
                        <p class="device-name">{{ d.nome }}</p>
                    </div>
                    {# 'pending' = cadastrado mas nunca completou o handshake com o
                       Core (ver PoseidonDevice::$status) — é um estado normal de
                       setup, diferente de 'offline' (já funcionou e parou), então
                       ganha um pill próprio em vez de cair disfarçado de offline. #}
                    <span class="pill {{ d.status == 'online' ? 'online' : (d.status == 'alert' ? 'alert' : (d.status == 'pending' ? 'pending' : '')) }}">
                        <span class="pill-dot"></span>{{ d.status == 'online' ? 'Online' : (d.status == 'alert' ? 'Alerta' : (d.status == 'pending' ? 'Pendente' : 'Offline')) }}
                    </span>
                </div>
                <div class="device-telemetry">
                    <div><span>Água</span><b>{{ d.telemetria.temp_agua|default('--') }}</b></div>
                    <div><span>Umid.</span><b>{{ d.telemetria.umidade|default('--') }}</b></div>
                    <div><span>Luz</span><b>{{ d.telemetria.luz|default('--') }}</b></div>
                </div>
            </a>
        {% else %}
            <div class="empty-devices">Nenhum dispositivo Poseidon cadastrado ainda.</div>
        {% endfor %}
    </div>

    {# --------------------- Seção: Horus --------------------- #}
    <div class="section-head">
        <p class="eyebrow">Horus</p>
    </div>
    <a href="{{ path('app_modulo_horus') }}" class="module-card">
        <div class="device-top">
            <div>
                <p class="device-type">Segurança</p>
                <p class="device-name">Horus</p>
            </div>
            <span class="pill {{ horus.status == 'online' ? 'online' : (horus.status == 'alert' ? 'alert' : '') }}">
                <span class="pill-dot"></span>{{ horus.status == 'online' ? 'Online' : (horus.status == 'alert' ? 'Alerta' : 'Offline') }}
            </span>
        </div>
        <div class="module-stats">
            <div class="module-stat">
                <span class="module-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5V6a1.5 1.5 0 0 0-1.5-1.5H4.5A1.5 1.5 0 0 0 3 6v9a1.5 1.5 0 0 0 1.5 1.5h9A1.5 1.5 0 0 0 15 15v-4.5Zm0 0 4.72-2.36a.75.75 0 0 1 1.08.67v7.38a.75.75 0 0 1-1.08.67L15 13.5"/></svg></span>
                <div><span>Câmeras</span><b>{{ horus.camerasAtivas }}<small>/{{ horus.camerasTotal }}</small></b></div>
            </div>
            <div class="module-stat">
                <span class="module-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M15.75 3v1.5M3 8.25h18M5.25 5.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25Z"/></svg></span>
                <div><span>Dispositivos</span><b>{{ horus.dispositivosAtivos }}<small>/{{ horus.dispositivosTotal }}</small></b></div>
            </div>
            <div class="module-stat">
                <span class="module-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9.75V6a3.75 3.75 0 1 1 7.5 0M6.75 21h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75A2.25 2.25 0 0 0 6.75 21Z"/></svg></span>
                <div><span>Portão</span><b>{{ horus.portaoEstado == 'travado' ? 'Travado' : 'Destravado' }}</b></div>
            </div>
        </div>
    </a>

    {# --------------------- Novo módulo (placeholder) --------------------- #}
    <div class="module-placeholder">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        Novo módulo
    </div>

{% endblock %}
